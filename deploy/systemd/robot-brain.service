[Unit]
Description=Robot service: brain
PartOf=robot.target
After=robot-broker.service
Requires=robot-broker.service

[Service]
Type=notify
NotifyAccess=all
User=@USER@
Group=@USER@
SupplementaryGroups=video audio gpio i2c spi render input
WorkingDirectory=@REPO@
EnvironmentFile=-@REPO@/config/robot.env
Environment=PYTHONUNBUFFERED=1
ExecStart=@VENV@/bin/robot run brain
Restart=always
RestartSec=2
WatchdogSec=30
TimeoutStopSec=10
# The language model is the one thing allowed to be starved.
CPUWeight=50
MemoryHigh=3G
MemoryMax=3500M
OOMScoreAdjust=500

[Install]
WantedBy=robot.target
