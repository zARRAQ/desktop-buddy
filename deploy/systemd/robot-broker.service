[Unit]
Description=Robot bus broker (ZeroMQ XSUB/XPUB)
PartOf=robot.target
Before=robot-safety.service robot-motion.service robot-face.service robot-perception.service robot-voice.service robot-brain.service robot-orchestrator.service

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=@REPO@
EnvironmentFile=-@REPO@/config/robot.env
ExecStart=@VENV@/bin/robot run broker
Restart=always
RestartSec=1
Nice=-5

[Install]
WantedBy=robot.target
